Library("xp_kernel32")

FORCE_STATIC_LIB = True
NO_EXPAND_LIBS = True

SOURCES += ["xp_kernel32.cpp"]

if CONFIG["TARGET_CPU"] == "x86":
    SOURCES += ["xp_forwarders_kernel32.asm"]
    SOURCES["xp_forwarders_kernel32.asm"].flags += ["-safeseh"]
elif CONFIG["TARGET_CPU"] == "x86_64":
    SOURCES += ["xp_forwarders_kernel32A.asm"]

CXXFLAGS += [
    "-clang:-fno-lto",
    "-fno-builtin",
]
